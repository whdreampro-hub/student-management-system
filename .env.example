# Database connection (configure in the PHP CLI and web-server environment)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_management
DB_USERNAME=student_management_user
DB_PASSWORD=replace_with_a_private_database_password

# Required only when creating the first administrator with php scripts/setup.php
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
INITIAL_ADMIN_FULL_NAME=School Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
